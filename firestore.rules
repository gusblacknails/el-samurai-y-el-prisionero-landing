rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /participantes/{docId} {
      // Solo crear participaciones autenticadas de forma anónima
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId',
          'nombre',
          'primer_apellido',
          'segundo_apellido',
          'email',
          'telefono',
          'provincia'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.primer_apellido is string
        && request.resource.data.segundo_apellido is string
        && request.resource.data.email is string
        && request.resource.data.telefono is string
        && request.resource.data.provincia is string;

      allow read, update, delete: if false;
    }
  }
}
